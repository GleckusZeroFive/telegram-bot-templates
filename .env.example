# Telegram
TELEGRAM_BOT_TOKEN=your_token_here

# Product preset: default | corporate_faq | customer_support | legal_assistant | tutor | voice_assistant
BOT_PRESET=default

# PostgreSQL (in docker compose the host is overridden to "postgres")
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragbot
POSTGRES_USER=ragbot
POSTGRES_PASSWORD=change_me

# Qdrant (in docker compose the host is overridden to "qdrant")
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM — any OpenAI-compatible API. Examples:
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=deepseek/deepseek-v4.1-flash
#               LLM_EXTRA_BODY={"reasoning": {"enabled": false}}
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4.1-mini
#   Ollama:     LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=qwen3:8b  (key not needed)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Extra JSON fields sent with every LLM request. Reasoning models spend max_tokens on thinking:
# the intent classifier gets 20 tokens and receives an empty answer unless reasoning is disabled.
# The syntax is provider-specific; the value above is for OpenRouter-compatible APIs.
LLM_EXTRA_BODY={}
# Several keys for round-robin (optional): LLM_API_KEYS=key1,key2
LLM_API_KEYS=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60
# Deadline for query rewriting and HyDE; on timeout the search uses the original question
LLM_AUX_TIMEOUT=15

# Optional fallback on 429 / 5xx / timeouts. Empty URL, key and extra body reuse the primary ones.
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_EXTRA_BODY=

# Embeddings (local sentence-transformers model, baked into the Docker image)
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNKER_MODE=advanced
MIN_CHUNK_SIZE=50
RETRIEVER_TOP_K=5
RETRIEVER_SCORE_THRESHOLD=0.35
HYDE_ENABLED=true
QUERY_REWRITE_ENABLED=true

# Intent classifier: local ONNX model, LLM when unsure. false = ambiguous messages go to RAG
CLASSIFIER_ENABLED=true

# Embedding batching
EMBEDDING_BATCH_MAX_ITEMS=256

# OCR (Tesseract)
OCR_ENABLED=true
OCR_LANGUAGES=rus+spa+eng
OCR_TEXT_THRESHOLD=50

# Speech-to-Text (voice messages, faster-whisper; the Docker image bakes the "small" model)
STT_ENABLED=true
WHISPER_MODEL_SIZE=small
WHISPER_LANGUAGE=ru
WHISPER_MAX_DURATION=60

# Uploads
MAX_FILE_SIZE_MB=20

# Russian law corpus (external service, optional)
LAW_CORPUS_ENABLED=false
LAW_API_URL=http://localhost:8100
LAW_CORPUS_TOP_K=5
LAW_CORPUS_WEIGHT=0.7
